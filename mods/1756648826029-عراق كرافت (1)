------MultipartBoundary--rtri8V00aXgXqMBgwLpbBAuB5zdtf9kEIMrcVLcPGi----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://iraqcraft.com/index.css

@charset "utf-8";

:root { --primary-green: #00ff7f; --dark-bg-gradient: linear-gradient(to right, #0f2027, #203a43, #2c5364); --dark-card-bg: rgba(34, 34, 34, 0.95); --dark-overlay-bg: rgba(0, 0, 0, 0.9); --text-color: #fff; --light-gray-text: #bbb; --border-radius-sm: 8px; --border-radius-md: 15px; --box-shadow-green-glow: 0 0 20px rgba(0, 255, 127, 0.7); --transition-speed: 0.3s ease-in-out; }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

html { scroll-behavior: smooth; }

body { font-family: Tajawal, Roboto, sans-serif; background: var(--dark-bg-gradient); color: var(--text-color); text-align: center; line-height: 1.7; min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; padding-bottom: 70px; }

.sr-only { position: absolute; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; border-width: 0px; }

.container { max-width: 1200px; margin: 0px auto; padding: 20px; width: 100%; }

.flex-center { display: flex; align-items: center; justify-content: center; }

.glass-effect { backdrop-filter: blur(15px) brightness(85%); background-color: rgba(34, 34, 34, 0.65); border: 1px solid rgba(0, 255, 127, 0.4); box-shadow: rgba(0, 255, 127, 0.25) 0px 6px 20px; }

.header { display: none; }

.welcome-box { width: 90%; max-width: 500px; margin: 30px auto; padding: 22px; border-radius: var(--border-radius-md); border: 4px solid var(--primary-green); font-size: 22px; font-weight: 700; color: var(--primary-green); min-height: 90px; box-shadow: var(--box-shadow-green-glow); transition: all var(--transition-speed); text-shadow: rgba(0, 0, 0, 0.6) 1px 1px 4px; animation: 2.5s ease-in-out 0s infinite alternate none running pulseBorder; display: flex; align-items: center; justify-content: center; }

@keyframes pulseBorder { 
  0% { border-color: var(--primary-green); box-shadow: rgba(0, 255, 127, 0.6) 0px 0px 15px; }
  100% { border-color: rgba(0, 255, 127, 0.6); box-shadow: rgba(0, 255, 127, 0.9) 0px 0px 25px; }
}

.search-section { padding: 20px 25px; background: rgba(32, 58, 67, 0.8); border-radius: var(--border-radius-md); margin: 25px auto; max-width: 650px; box-shadow: rgba(0, 0, 0, 0.5) 0px 6px 18px; }

.search-container { display: flex; gap: 12px; max-width: 550px; margin: 0px auto; }

.search-container input { flex: 1 1 0%; padding: 14px 18px; border: 2px solid var(--primary-green); border-radius: var(--border-radius-sm); background-color: rgba(34, 34, 34, 0.95); color: var(--text-color); font-size: 18px; outline: none; transition: border-color var(--transition-speed), box-shadow var(--transition-speed); }

.search-container input::placeholder { color: var(--light-gray-text); opacity: 0.9; }

.search-container input:focus { border-color: rgb(50, 225, 109); box-shadow: rgba(0, 255, 127, 0.8) 0px 0px 12px; }

